<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="ClientPortalSuite">

	<listeners>
        <listener class-name="utilities.ExtentReportManager"/>
    </listeners>

	<!-- Login page-->
	<test name="Login Test">
        <classes>
            <class name="testcases.LoginTest">
            
            	<methods>
            			<include name="verifyValidLogin"/>
           		 </methods>
            
            </class>   
            
            
            <!--  navigation to document dashboard-->
             <class name="testcases.DocumentDashboardTest">
            
                <methods>
                    	<include name="verifyNavigationToDocumentDashboard"/>
                </methods>
                
            </class>
            
            
           <!-- Create Document --> 
    
            <class name="testcases.CreateDocumentTest">
            	<methods>
            			<include name="verifyCreatePrivateDocument"/>
            			
            	</methods>
            </class> 
            
       	</classes>
 	</test>
      
           <!--  Profile menu options -->   
     <test name="Profile action">
           <classes>
                <class name="testcases.DocumentDashboardTest">
            
               		<methods>
                  			<include name="verifyProfileMenuOptions"/>
                    		<include name="verifyLogout"/>
                	</methods>
                
            </class>  
            
            
            <!--  User Dashboard -->
            <class name="testcases.CreateDocumentTest">
            	<methods>
            			<include name="verifyUserDashboard"/>
            			
            	</methods>
            	
            </class>       
        </classes>
        
    </test>
    
    

</suite>